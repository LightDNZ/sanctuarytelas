# Copie para .env e preencha. Ou rode "npm run configurar", que faz isso sozinho.

# Assina os tokens. Obrigatório, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=8f7796b009081534214c3c9b66fd4e7abf7ccbe385972e7cda1dba0f3706d1f9

# Sem os dois, não abre dentro do Discord.
# No portal: https://discord.com/developers/applications, aba OAuth2.
DISCORD_CLIENT_ID=1539405022234673162
DISCORD_CLIENT_SECRET=JOjznW-j2Snl-aoeJetOejwRraaCVfku

# Opcional. Confere se a pessoa está mesmo na call, e traz nome, imagem e
# tamanho dos servidores no painel. O bot precisa estar no servidor.
# No mesmo portal, aba Bot, botão Reset Token.
DISCORD_BOT_TOKEN=

# Endereço público. Quem abre o túnel preenche sozinho.
PUBLIC_ORIGIN=https://sanctuarytelas.duckdns.org

# Porta local.
PORT=3001

# "production" liga as travas de segurança.
NODE_ENV=production

# Túnel de endereço fixo. Preenchido por "npm run tunel:criar".
TUNEL_CONFIG=https://sanctuarytelas.duckdns.org

# ID da sua conta, não o Client ID nem o do servidor. Mais de um: separe por vírgula.
# No Discord, não no portal: Configurações, Avançado, Modo desenvolvedor.
# Depois botão direito no seu nome, Copiar ID.
# Só estas contas abrem /admin. Vazio = painel desligado.
DISCORD_ADMIN_ID=952566840725479424

# Opcional. Servidor TURN para a conexão direta entre quem transmite e quem
# assiste. Sem ele o WebRTC ainda funciona na maioria das casas — o STUN
# público basta —, mas quem está atrás de NAT simétrico (CGNAT da operadora,
# rede corporativa) não consegue fechar e cai no relay, que é mais pesado para
# o servidor. TURN encaminha o vídeo de fato, então custa banda.
TURN_URL=
TURN_USER=
TURN_PASS=